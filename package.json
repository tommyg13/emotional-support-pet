{
  "name": "emotional-support-pet",
  "version": "0.1.16",
  "description": "A floating emotional support button that summons a big cat or lizard",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --config electron-builder.config.js",
    "dist:win": "electron-builder --win --config electron-builder.config.js",
    "vendor:three": "node scripts/vendor-three.cjs",
    "check:pomeranian": "electron scripts/check-pomeranian-gaze.cjs",
    "check:pomeranian-care": "electron scripts/check-pomeranian-care.cjs",
    "check:pomeranian-ball": "electron scripts/check-pomeranian-ball.cjs",
    "check:pomeranian-idle": "electron scripts/check-pomeranian-idle.cjs",
    "check:pomeranian-dev": "electron scripts/check-pomeranian-dev.cjs",
    "check:pomeranian-recovery": "electron scripts/check-pomeranian-recovery.cjs",
    "check:pomeranian-roaming": "electron scripts/check-pomeranian-roaming.cjs",
    "check:pomeranian-gait": "electron scripts/check-pomeranian-gait.cjs",
    "check:pomeranian-rest": "electron scripts/check-pomeranian-rest.cjs",
    "check:pomeranian-pickup": "electron scripts/check-pomeranian-pickup.cjs",
    "check:pomeranian-life": "electron scripts/check-pomeranian-life.cjs",
    "check:pomeranian-interaction": "electron scripts/check-pomeranian-interaction.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "lottie-web": "^5.12.2",
    "three": "0.180.0",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "productName": "Emotional Support Pet",
  "author": "You"
}
