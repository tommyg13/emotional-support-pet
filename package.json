{
  "name": "emotional-support-pet",
  "version": "0.1.0",
  "description": "A floating emotional support button that summons a big cat or lizard",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "lottie-web": "^5.12.2"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "productName": "Emotional Support Pet",
  "author": "You",
  "build": {
    "appId": "com.example.emotionalsupportpet",
    "productName": "Emotional Support Pet",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.lifestyle",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "YOUR_GITHUB_USER",
      "repo": "emotional-support-pet",
      "releaseType": "release"
    }
  }
}